#!/usr/bin/env zsh
src "$(basename "${(%):-%x}")"

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
debug "Detected BASEDIR=$BASEDIR"

# Request sudo privileges
info "Requesting sudo privileges..."
if sudo -v 2>/dev/null; then
  success "  ✓ Sudo access granted"
  debug "  Keeping sudo alive..."
  while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
else
  fail "  ✗ Sudo access denied"
fi

#info "Checking local git setup..."
#if setup_gitconfig 2>&1
#then
#  success "  Git config setup done"
#else
#  fail "  Error setting up git config"
#fi

# Run DotBot install script
user "Running DotBot installation..."
if source ./run-dotbot; then
  success "  ✓ Dotbot completed successfully!"
else
  fail "  ✗ Dotbot installation failed!"
fi

# macOS-specific setup
if [[ "$(uname -s)" == "Darwin" ]]; then
  debug "Detected macOS, proceeding with additional setup..."
  export DOTS="$XDG_CONFIG_HOME/.dotfiles"

  # TODO: Go over the defaults config
  #info "Setting OS X defaults..."
  #debug "  running: $DOTS/zsh-setup-scripts/osx/set-defaults.sh"
  #if $DOTS/zsh-setup-scripts/osx/set-defaults.sh 2>&1
  #then
  #  success "  OS X defaults set"
  #  user "    NOTE that some of these changes require a logout/restart to take effect."
  #else
  #  fail "  Error setting OS X defaults"
  #fi

  user "Installing dependencies..."
  if source "$DOTS/zsh-setup-scripts/script/install-deps"; then
    success "  ✓ Dependencies installed successfully"
  else
    fail "  ✗ Dependency installation failed"
  fi
else
  debug "Non-macOS system detected, skipping macOS setup."
fi

# Completion message
echo ""
success " ✓ Installation complete!"
echo ""
