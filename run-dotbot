#!/usr/bin/env zsh
#
# Symlinks and XDG dirs via DotBot. Run it as ./run-dotbot, or source it
# from install-all / install-server (both run it from the repo root).
#
# Status: 0 = all links done, 1 = dotbot ran but some links or tasks
# failed, 2 = dotbot could not run (no Homebrew, no dotbot, no config).
#
# All work happens inside _run_dotbot with local variables, so a caller
# that sources this file gets only the status — no exit_code or output
# leaks into its scope. The XDG_* exports are the one intended effect.

source helpers.zsh

_run_dotbot() {
  local output dotbot_status reenable_debug=false
  local config="dotbot.conf.yaml"

  if source zsh-setup-scripts/homebrew/is_installed.sh; then
    log_success "Homebrew is installed"
  else
    log_fail "Homebrew installation failed. Please check the logs above."
    return 2
  fi

  if ! command -v dotbot &>/dev/null; then
    log_warn "Dotbot not installed. Installing now..."
    if brew install dotbot 2>&1 | output_stream; then
      log_success "Dotbot installed successfully!"
    else
      log_fail "Dotbot installation failed!"
      return 2
    fi
  else
    log_success "Dotbot already installed"
    log_user "Updating Dotbot..."
    if output=$(brew upgrade dotbot 2>&1); then
      print -r -- "$output" | grep -v "already installed" | output_stream 2>/dev/null
      log_success "Dotbot update successful"
    else
      print -r -- "$output" | output_stream 2>/dev/null
      log_fatal "Dotbot update failed"
      return 2
    fi
  fi

  # Defaults match xdg_config/zsh/.zshenv. On a new machine that file is not
  # linked yet, so these are the values dotbot.conf.yaml expands. DotBot
  # expands ${VAR} in the config itself; no envsubst pass is needed.
  typeset -gx XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
  typeset -gx XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
  typeset -gx XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
  typeset -gx XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

  if [[ ! -s "$config" ]]; then
    log_fatal "Dotbot config file '$config' is missing or empty!"
    return 2
  fi

  # dotbot.conf.yaml links the atuin theme from this submodule, and a plain
  # clone leaves it empty. Init it only when missing, so a submodule that
  # was moved on purpose stays where it is.
  if [[ ! -e git-submodules/atuin-tokyo-night/.git ]]; then
    log_user "Initialising the atuin theme submodule..."
    git submodule update --init git-submodules/atuin-tokyo-night 2>&1 | output_stream
  fi

  log_user "Starting Dotbot..."
  if is_debug_enabled; then
    _disable_debug
    reenable_debug=true
  fi
  output=$(dotbot --force-color -c "$config" "$@" 2>&1)
  dotbot_status=$?
  [[ "$reenable_debug" == "true" ]] && _enable_debug

  print -r -- "$output" | output_stream 2>/dev/null
  (( dotbot_status == 0 )) || return 1
  return 0
}

_run_dotbot "$@"
