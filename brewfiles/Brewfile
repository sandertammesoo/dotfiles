#############################################
# Minimal Brewfile for setting up a new Mac #
#############################################

# Configuration
cask_args appdir: '/Applications'

# Homebrew Taps
# Custom repositories for specialized tools and utilities
tap "felixkratz/formulae"       # macOS window management and status bar tools (Sketchybar)
tap "asmvik/formulae"      # macOS tiling window manager and hotkey daemon (Yabai, SKHD)
tap "sandertammesoo/formulae"   # Personal formulae repository
tap "buo/cask-upgrade"          # Enhanced cask management - upgrade all apps: brew cu

# Essential System Tools
# Core system utilities required for basic functionality
brew "mas"                      # Mac App Store command-line interface https://github.com/mas-cli/mas

brew "taproom"      # Homebrew tap management utilities

################################
##### COMMAND LINE TOOLS ######
################################

# Core System Utilities
# Essential GNU/Linux tools for macOS - replaces BSD versions with GNU equivalents
brew "coreutils"                # GNU File, Shell, and Text utilities https://www.gnu.org/software/coreutils
brew "moreutils"                # Collection of tools that nobody wrote when UNIX was young https://joeyh.name/code/moreutils/
brew "findutils"                # Collection of GNU find, xargs, and locate https://www.gnu.org/software/findutils/
brew "diffutils"                # File comparison utilities https://www.gnu.org/software/diffutils/
# brew "gnu-sed", args: ["with-default-names"] # GNU implementation of the famous stream editor https://www.gnu.org/software/sed/
# brew "watch"                  # Executes a program periodically, showing output fullscreen https://gitlab.com/procps-ng/procps

# Search & Navigation Tools
# Enhanced search and file navigation utilities - modern alternatives to classic tools
brew "grep"                     # GNU grep, egrep and fgrep https://www.gnu.org/software/grep/
brew "ack"                      # Search tool like grep, but optimized for programmers https://beyondgrep.com/
brew "ripgrep"                  # Search tool like grep and The Silver Searcher https://github.com/BurntSushi/ripgrep
brew "fzf"                      # Command-line fuzzy finder written in Go https://github.com/junegunn/fzf
brew "television"               # General purpose fuzzy finder TUI https://github.com/alexpasmantier/television
brew "fd"                       # Simple, fast and user-friendly alternative to find https://github.com/sharkdp/fd
brew "tree"                     # Display directories as trees (with optional color/HTML output) https://oldmanprogrammer.net/source.php?dir=projects/tree
brew "zoxide"                   # Shell extension to navigate your filesystem faster https://github.com/ajeetdsouza/zoxide

# File Management & Viewing
# Enhanced file manipulation and viewing tools - modern replacements for cat, ls, etc.
brew "bat"                      # Clone of cat(1) with syntax highlighting and Git integration https://github.com/sharkdp/bat
brew "eza"                      # Modern, maintained replacement for ls https://github.com/eza-community/eza
brew "superfile"                # Modern and pretty fancy file manager for the terminal https://superfile.netlify.app/
brew "stow"                     # Organize software neatly under a single directory tree (e.g. /usr/local) https://www.gnu.org/software/stow/
brew "unp"                      # Unpack everything with one command https://tracker.debian.org/pkg/unp
# brew "ranger"                   # Console file manager with VI key bindings https://ranger.github.io/

# Network & Security Tools
# Network utilities and security tools for connectivity and encryption

# Network Analysis & Diagnostics
brew "wget"                     # Internet file retriever https://www.gnu.org/software/wget/
brew "nmap"                     # Port scanning utility for large networks https://nmap.org/
brew "mtr"                      # 'traceroute' and 'ping' in a single tool https://www.bitwizard.nl/mtr/
brew "doge"                     # Command-line DNS client https://dog.ramfield.net/
brew "ipcalc"                   # Calculate various network masks, etc. from a given IP address https://jodies.de/ipcalc
brew "wifi-password"            # Show the current WiFi network password https://github.com/rauchg/wifi-password
# brew "mosh"                   # Mobile shell for remote terminal access over SSH https://mosh.org/
# brew "termshark"              # Terminal user interface for tshark https://termshark.io/

# Security & Encryption
brew "gnupg"                    # GNU Privacy Guard (includes gpg command) https://gnupg.org/
brew "magic-wormhole"           # Securely send files and directories from one computer to another https://github.com/magic-wormhole/magic-wormhole

# Secret scanning — see docs/adr/0002-secret-scanning.md.
# gitleaks is the always-on gate (global pre-commit hook + CI); trufflehog is
# the auditor, used on demand because it verifies findings over the network.
brew "gitleaks"                 # Detect hardcoded secrets in git repos https://github.com/gitleaks/gitleaks
brew "trufflehog"               # Find and verify leaked credentials https://github.com/trufflesecurity/trufflehog

# System Monitoring & Performance
# System monitoring and performance analysis tools
brew "htop"                     # Improved top (interactive process viewer) https://htop.dev/
brew "macmon"                   # Sudoless performance monitoring for Apple Silicon processors https://github.com/vladkens/macmon
brew "glances"                  # Cross-platform system monitoring tool https://nicolargo.github.io/glances/
brew "ncdu"                     # NCurses Disk Usage https://dev.yorhel.nl/ncdu
brew "duf"                      # Disk Usage/Free Utility https://github.com/muesli/duf
brew "procs"                    # Modern replacement for ps written in Rust https://github.com/dalance/procs
brew "progress"                 # Coreutils progress viewer https://github.com/Xfennec/progress

# Shell Enhancement & Documentation
# Tools to enhance shell experience, provide documentation, and improve terminal output

# Shell Prompt & Customization
brew "starship"                 # Cross-shell prompt for astronauts https://starship.rs/
brew "grc"                      # Generic Colouriser https://kassiopeia.juls.savba.sk/~garabik/software/grc.html

# Terminal Workspace Management
brew "herdr"                    # Terminal workspace manager for AI coding agents https://herdr.dev/

# Documentation & Help
brew "cheat"                    # Create and view interactive cheat sheets for *nix commands https://github.com/cheat/cheat
brew "tlrc"                     # Official tldr client written in Rust https://tldr.sh/tlrc
brew "tuxedo"                   # Fast, keyboard-driven terminal UI for todo.txt https://github.com/webstonehq/tuxedo

