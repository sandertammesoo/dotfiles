#!/usr/bin/env zsh
#
# Quick search in a directory for a string ($@).
#

set -e # Exit immediately if a command fails

# Check if ack-grep is available, fallback to ack, else show error
if command -v ack-grep &>/dev/null; then
    ack-grep -i "$@"
elif command -v ack &>/dev/null; then
    ack -i "$@"
else
    echo "Error: Neither ack-grep nor ack found!" >&2
    exit 1
fi
