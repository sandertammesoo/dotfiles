#!/usr/bin/env zsh
# Add or remove try-rs source folders (TUI tabs) in config.toml.
#
#   try-paths                      list the tabs, numbered
#   try-paths add [dir] [--at N]   append a folder (default: the current
#                                  folder), or insert it as tab N and push
#                                  the later tabs back by one
#   try-paths add [dir] --first    same as --at 1: the folder where
#                                  `try <name>` creates
#   try-paths rm [dir|number]      remove a folder by path or list number
#                                  (default: the current folder)
#
# Edits only the tries_path line, so the comments in config.toml stay. The
# write goes to the symlink target, so the dotfiles repo gets the change.
# Paths under $HOME are stored as ~/..., the same as the hand-written ones.
# Manual: man try-paths (xdg_config/try-rs/man/try-paths.1).

setopt extended_glob

config="${TRY_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/try-rs}/${TRY_CONFIG:-config.toml}"
prog="${0:t}"

die() { print -u2 -- "${prog}: $*"; exit 1; }

usage() {
    print -- "usage: ${prog} [list] | add [dir] [--at N | --first] | rm [dir|number]"
}

help() {
    print -r -- "${prog} - list, add, and remove try-rs source folders (TUI tabs)

usage:
  ${prog} [list]                     print each tab with its number
  ${prog} add [dir]                  add dir as the last tab
  ${prog} add [dir] --at N           insert dir as tab N; later tabs move back by one
  ${prog} add [dir] --first          same as --at 1: new tries go to this folder
  ${prog} rm [dir|number]            remove a tab by path or by number

If there is no dir, add and rm use the current folder.
The first tab is the folder where \`try <name>\` creates a new try.

config: ${config}

See man ${prog} for the full manual."
}

# Absolute path with ~ expanded, no trailing slash, symlinks kept as written.
expand() {
    local p="${1/#\~/$HOME}"
    [[ "$p" == /* ]] || p="$PWD/$p"
    print -r -- "${p:a}"
}

# Absolute path back to the ~/... form used in config.toml.
abbrev() {
    if [[ "$1" == "$HOME" || "$1" == "$HOME"/* ]]; then
        print -r -- "~${1#$HOME}"
    else
        print -r -- "$1"
    fi
}

[[ -r "$config" ]] || die "no config at $config"

paths=()
line="$(grep -E '^[[:space:]]*tries_path[[:space:]]*=' "$config" | head -n 1)"
if [[ -n "$line" ]]; then
    value="${${line#*=}//\"/}"
    for entry in ${(s:,:)value}; do
        entry="${${entry##[[:space:]]#}%%[[:space:]]#}"
        [[ -n "$entry" ]] && paths+=("$entry")
    done
fi

list() {
    local i
    for (( i = 1; i <= $#paths; i++ )); do
        print -r -- "$i  ${paths[i]}"
    done
}

# Rewrite the tries_path line (or append one) and keep every other line.
save() {
    local target="${config:A}" tmp new
    new="tries_path = \"${(j:, :)paths}\""
    tmp="$(mktemp "${target:h}/.config.toml.XXXXXX")" || die "cannot write ${target:h}"
    if grep -qE '^[[:space:]]*tries_path[[:space:]]*=' "$target"; then
        awk -v new="$new" '
            !done && /^[[:space:]]*tries_path[[:space:]]*=/ { print new; done = 1; next }
            { print }
        ' "$target" > "$tmp"
    else
        { cat "$target"; print -r -- "$new"; } > "$tmp"
    fi
    mv -f "$tmp" "$target" || { rm -f "$tmp"; die "cannot replace $target"; }
}

# Index of a path in $paths (compared after ~ expansion), or 0.
index_of() {
    local want="$(expand "$1")" i
    for (( i = 1; i <= $#paths; i++ )); do
        [[ "$(expand "${paths[i]}")" == "$want" ]] && { print $i; return; }
    done
    print 0
}

cmd="${1:-list}"
(( $# )) && shift

case "$cmd" in
    list|ls)
        list
        ;;
    add)
        at="" dir=""
        while (( $# )); do
            case "$1" in
                --first) at=1 ;;
                --at) (( $# > 1 )) || die "--at needs a number"; at="$2"; shift ;;
                --at=*) at="${1#--at=}" ;;
                -*) die "unknown option $1" ;;
                *) [[ -z "$dir" ]] || die "add takes one folder"; dir="$1" ;;
            esac
            shift
        done
        abs="$(expand "${dir:-$PWD}")"
        [[ -d "$abs" ]] || die "not a folder: $abs (create it first)"
        (( $(index_of "$abs") == 0 )) || die "already a tab: $(abbrev "$abs")"
        (( pos = $#paths + 1 ))
        if [[ -n "$at" ]]; then
            [[ "$at" == <-> ]] && (( at >= 1 && at <= pos )) \
                || die "--at must be a number from 1 to $pos"
            pos="$at"
        fi
        paths[pos,pos-1]=("$(abbrev "$abs")")
        save
        list
        ;;
    rm|remove)
        (( $# <= 1 )) || { usage >&2; exit 1; }
        target="${1:-$PWD}"
        if [[ "$target" == <-> ]]; then
            idx="$target"
            (( idx >= 1 && idx <= $#paths )) || die "no tab number $idx"
        else
            idx="$(index_of "$target")"
            (( idx > 0 )) || die "not a tab: $(abbrev "$(expand "$target")")"
        fi
        (( $#paths > 1 )) || die "cannot remove the last tab"
        paths[idx]=()
        save
        list
        ;;
    -h|--help|help)
        help
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac
