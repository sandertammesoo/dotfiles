#!/usr/bin/env sh

# for this to work you must configure sudo such that
# it will be able to run the command without password
#
# see this wiki page for information:
#  - https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)#configure-scripting-addition
#
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# S K E T C H Y B A R  E V E N T S
yabai -m signal --add event="window_focused" action="sketchybar -m --trigger window_focus &> /dev/null"
yabai -m signal --add event="window_title_changed" action="sketchybar -m --trigger title_change &> /dev/null"

# B O R D E R S  (JankyBorders)
# Workaround for macOS 26 Tahoe: borders' accessibility observer gets stuck on
# floating windows after a few focus transitions. Sending any config update
# forces it to re-query the active window after yabai resolves focus correctly.
yabai -m signal --add label="borders_focus_refresh" event="window_focused" \
  action="borders ax_focus=on &>/dev/null"
# yabai -m signal --add label="flash_focus" event="window_focused" action="yabai -m window \$YABAI_WINDOW_ID --opacity 0.3 && sleep 0.2 && yabai -m window \$YABAI_WINDOW_ID --opacity 0.0"

# D E B U G  L O G G I N G  F O R  M I N I M I Z E  B U G
yabai -m signal --add event=window_minimized action='date "+[%Y-%m-%d %H:%M:%S:%N] MINIMIZED: $YABAI_WINDOW_ID ($YABAI_WINDOW_APP)" >> /tmp/yabai_minimize_debug.log'
yabai -m signal --add event=window_deminimized action='date "+[%Y-%m-%d %H:%M:%S:%N] DEMINIMIZED: $YABAI_WINDOW_ID ($YABAI_WINDOW_APP)" >> /tmp/yabai_minimize_debug.log'
yabai -m signal --add event=window_focused action='echo "[$(date "+%Y-%m-%d %H:%M:%S:%N")] FOCUSED: $YABAI_WINDOW_ID ($YABAI_WINDOW_APP) - is-minimized=$(yabai -m query --windows --window $YABAI_WINDOW_ID 2>/dev/null | jq -r '."is-minimized"')" >> /tmp/yabai_minimize_debug.log'
yabai -m signal --add event=application_front_switched action='echo "[$(date "+%Y-%m-%d %H:%M:%S:%N")] APP SWITCHED: $YABAI_PROCESS_ID - $(ps -p $YABAI_PROCESS_ID -o comm= 2>/dev/null)" >> /tmp/yabai_minimize_debug.log'

## Optional signals - disabled by default
## Uncomment if you want automatic window stacking/positioning based on application events
## RATE-LIMITED: Now includes cascade prevention to avoid minimize bug
## TEMP DISABLED: application_activated script IS the actual root cause of minimize bug
## The window queries in this script disturb minimized windows system-wide
# yabai -m signal --add event=application_activated action="zsh ~/.config/yabai/application-activated.zsh"
## TEMP DISABLED: window_created signal IS the root cause of minimize bug cascade
# yabai -m signal --add event=window_created action="zsh ~/.config/yabai/window-created.zsh"

# Exclude apps from being managed:
# ── macOS system ──────────────────────────────────────────────────────────────
yabai -m rule --add label="macOS system" app="^(System (Settings|Information|Preferences)|Disk Utility|Activity Monitor|Archive Utility|App Store|Keychain)$" manage=off
yabai -m rule --add label="Apple first-party apps" app="^(FaceTime|Numbers|Pages|Notes|Reminders|Stocks|Find My|Messages|Passwords|Phone|Weather|Shortcuts)$" manage=off
yabai -m rule --add label="Preferences" title="(Preferences|Settings)$" manage=off
yabai -m rule --add label="YT-Pip" title="(Picture in Picture)$" manage=off
yabai -m rule --add label="About This Mac" app="System Information" title="About This Mac" manage=off

# ── Apple first-party ─────────────────────────────────────────────────────────
yabai -m rule --add label="Apple utility apps" app="^(Calculator|(Notion )?Calendar|FaceTime|Numbers)$" manage=off
yabai -m rule --add label="Finder" app="^Finder$" title="(Co(py|nnect)|Move|Info|Pref|Downloads)" manage=off
yabai -m rule --add label="Safari" app="^Safari$" title="^(General|(Tab|Password|Website|Extension)s|AutoFill|Se(arch|curity)|Privacy|Advance)$" manage=off

# ── Media ─────────────────────────────────────────────────────────────────────
yabai -m rule --add label="Media" app="^(Music|Podcasts|Preview|TV|VLC|IINA)$" manage=off

# ── Home ──────────────────────────────────────────────────────────────────────
yabai -m rule --add label="Home" app="^(Home( Assistant)?)$" manage=off

# ── Hardware control ──────────────────────────────────────────────────────────
yabai -m rule --add label="Hardware control" app="^((Elgato )?(Wave Link|Stream Deck))$" manage=off

# ── Dev tools ─────────────────────────────────────────────────────────────────
yabai -m rule --add label="Dev tools" app="^(DBeaver|Docker Desktop|Postman)$" manage=off

# ── Utilities & menu bar ──────────────────────────────────────────────────────
yabai -m rule --add label="Utilities and menu bar" app="^(1Password|DigiDoc4 Client|DockDoor|Hidden Bar|NordVPN|Shottr|Spotify|Timer RH|zoom.us|calibre|Keymapp|Logi Options+|Loom|Openscreen|PS Remote Play|Steam|Transmission|UTM|Antinote)$" manage=off
yabai -m rule --add label="Brave" app="^Brave Browser$" title="(Who\'s using Brave\?)" manage=off
yabai -m rule --add label="Slack huddle" app="^Slack$" title="(Huddle)" manage=off
yabai -m rule --add label="Slack help" app="^Slack$" title="^(Help)" manage=off
# The rule above doesn't catch the help window because yabai evaluates the rule
# before Slack sets the window title. This signal floats it once the title is set.
yabai -m signal --add label="slack_help_float" event=window_title_changed app="^Slack$" \
  action='win=$(yabai -m query --windows --window "$YABAI_WINDOW_ID"); [[ "$(echo "$win" | jq -r ".title")" =~ ^Help ]] && [[ "$(echo "$win" | jq -r ".\"is-floating\"")" == "false" ]] && yabai -m window "$YABAI_WINDOW_ID" --toggle float'

# ── Design & CAD ──────────────────────────────────────────────────────────────
yabai -m rule --add label="Design and CAD" app="^(DraftSight|Fusion|Inkscape|Sweet Home 3D|Affinity)$" manage=off
# yabai -m rule --add label="Select file to save to" app="^Inkscape$" title="Select file to save to" manage=off


# global settings
yabai -m config mouse_follows_focus off \
                focus_follows_mouse off \
                window_origin_display default \
                window_placement second_child \
                window_zoom_persist on \
                window_shadow off \
                window_animation_duration 0.2 \
                window_animation_easing ease_in_out_cubic \
                window_opacity_duration 0.2 \
                active_window_opacity 1 \
                normal_window_opacity 0.90 \
                window_opacity on \
                insert_feedback_color 0xffd75f5f \
                split_ratio 0.5 \
                split_type auto \
                auto_balance off \
                layout bsp \
                mouse_modifier fn \
                mouse_action1 move \
                mouse_action2 resize \
                mouse_drop_action swap \
                external_bar all:0:37 \
                top_padding 2 \
                bottom_padding 0 \
                left_padding 6 \
                right_padding 6 \
                window_gap 8
#split_ratio 0.64

#yabai -m config --space $(yabai -m query --displays | jq 'map(select(.index==2)) | .[0].spaces[0]') left_padding 0
#yabai -m config --space $(yabai -m query --displays | jq 'map(select(.index==2)) | .[0].spaces[0]') right_padding 0
#yabai -m config --space $(yabai -m query --displays | jq 'map(select(.index==2)) | .[0].spaces[1]') left_padding 0
#yabai -m config --space $(yabai -m query --displays | jq 'map(select(.index==2)) | .[0].spaces[1]') right_padding 0

# O P A C I T Y  O V E R R I D E S
# Per-app and per-title opacity via window_focused signals.
# Global defaults above: active=0.97, normal=0.90
# Set --opacity 0.0 on a window to reset it back to global defaults.
#
# Note: per-window --opacity overrides persist until explicitly reset.
# Yabai applies active/normal_window_opacity automatically for windows
# that haven't been given a per-window override.

# Example: Make WezTerm slightly more transparent when focused
# yabai -m signal --add label="opacity_wezterm" event=window_focused \
#   action='[ "$YABAI_WINDOW_APP" = "WezTerm" ] && yabai -m window "$YABAI_WINDOW_ID" --opacity 0.88'

# Example: Force full opacity for video/screen-share apps (override global)
_force_opacity_apps="zoom\.us|Loom|Openscreen|PS Remote Play|FaceTime|System (Settings|Information|Preferences)|Disk Utility|Activity Monitor|Archive Utility|App Store|Keychain|Find My|Finder|Preview|VLC|IINA|Shottr|DraftSight|Fusion|Inkscape|Sweet Home 3D|Affinity"
yabai -m signal --add label="opacity_opaque_apps" event=window_focused app="^(${_force_opacity_apps})$" action='yabai -m window "$YABAI_WINDOW_ID" --opacity 1.0'
unset _force_opacity_apps

# Example: Dim windows whose title contains reference/doc keywords
# yabai -m signal --add label="opacity_docs_titles" event=window_focused \
#   action='title=$(yabai -m query --windows --window "$YABAI_WINDOW_ID" 2>/dev/null | jq -r ".title // empty")
#   case "$title" in
#     *README*|*CHANGELOG*|*" — docs"*) yabai -m window "$YABAI_WINDOW_ID" --opacity 0.85 ;;
#     *) yabai -m window "$YABAI_WINDOW_ID" --opacity 0.0 ;;  # reset others to global
#   esac'

# Browser opacity overrides: title-based rules shared across Brave and Safari.
# Non-zero per-window opacity persists until explicitly reset, so setting once on focus/title is enough.
_browser_always_pages="(Fractory|MP) (-|—)|YouTube|Netflix|Disney\\+|Meet|Figma|\\.pdf|Picture in Picture"
_browser_focus_pages="Reddit"
_browser_app_pattern="Brave Browser|Safari"

# Always-opaque: 1.0 regardless of focus (video, meetings, PDFs, design tools)
_opacity_browser_always=$(cat <<EOACTION
title=\$(yabai -m query --windows --window "\$YABAI_WINDOW_ID" 2>/dev/null | jq -r ".title // empty")
if printf "%s" "\$title" | grep -qE "${_browser_always_pages}"; then
  yabai -m window "\$YABAI_WINDOW_ID" --opacity 1.0
fi
EOACTION
)

# Focus-opaque: 1.0 when focused, global active/normal opacity otherwise.
# The elif guards against resetting always-opaque pages that don't match focus-opaque list.
_opacity_browser_focus=$(cat <<EOACTION
title=\$(yabai -m query --windows --window "\$YABAI_WINDOW_ID" 2>/dev/null | jq -r ".title // empty")
if printf "%s" "\$title" | grep -qE "${_browser_focus_pages}"; then
  yabai -m window "\$YABAI_WINDOW_ID" --opacity 1.0
elif ! printf "%s" "\$title" | grep -qE "${_browser_always_pages}"; then
  yabai -m window "\$YABAI_WINDOW_ID" --opacity 0.0
fi
EOACTION
)

# Reset focus-opaque browser windows when a non-browser app gains focus
_opacity_browser_focus_reset=$(cat <<EOACTION
printf "%s" "\$YABAI_WINDOW_APP" | grep -qE "^(${_browser_app_pattern})$" && exit 0
yabai -m query --windows 2>/dev/null | jq -c ".[]" | while IFS= read -r win; do
  wid=\$(printf "%s" "\$win" | jq -r ".id")
  wtitle=\$(printf "%s" "\$win" | jq -r ".title // empty")
  if printf "%s" "\$wtitle" | grep -qE "${_browser_focus_pages}"; then
    yabai -m window "\$wid" --opacity 0.0
  fi
done
EOACTION
)

yabai -m signal --add label="opacity_brave_always_focused"        event=window_focused       app="^Brave Browser$" action="$_opacity_browser_always"
yabai -m signal --add label="opacity_brave_always_title_changed"  event=window_title_changed app="^Brave Browser$" action="$_opacity_browser_always"
yabai -m signal --add label="opacity_brave_focus_focused"         event=window_focused       app="^Brave Browser$" action="$_opacity_browser_focus"
yabai -m signal --add label="opacity_brave_focus_title_changed"   event=window_title_changed app="^Brave Browser$" action="$_opacity_browser_focus"
yabai -m signal --add label="opacity_safari_always_focused"       event=window_focused       app="^Safari$"        action="$_opacity_browser_always"
yabai -m signal --add label="opacity_safari_always_title_changed" event=window_title_changed app="^Safari$"        action="$_opacity_browser_always"
yabai -m signal --add label="opacity_safari_focus_focused"        event=window_focused       app="^Safari$"        action="$_opacity_browser_focus"
yabai -m signal --add label="opacity_safari_focus_title_changed"  event=window_title_changed app="^Safari$"        action="$_opacity_browser_focus"
yabai -m signal --add label="opacity_browser_focus_reset"         event=window_focused                             action="$_opacity_browser_focus_reset"
unset _opacity_browser_always _opacity_browser_focus _opacity_browser_focus_reset _browser_always_pages _browser_focus_pages _browser_app_pattern

# Apply all rules to already-open windows (rules only fire on window_created by
# default, so existing windows are not managed correctly after a restart).
yabai -m rule --apply

echo "yabai configuration loaded.."

