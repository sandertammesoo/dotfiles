# ============================================================================
# Network Security & Reconnaissance
# ============================================================================

brew "feroxbuster"  # Fast, simple, recursive content discovery tool written in Rust - https://epi052.github.io/feroxbuster
brew "hydra"        # Network logon cracker which supports many services - https://github.com/vanhauser-thc/thc-hydra
brew "nmap"         # Port scanning utility for large networks - https://nmap.org/
brew "wget"         # Internet file retriever - https://www.gnu.org/software/wget/
brew "wireguard-tools" # Tools for the WireGuard secure network tunnel - https://www.wireguard.com/

