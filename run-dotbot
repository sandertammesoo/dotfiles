#!/usr/bin/env zsh
source helpers.zsh

# Ensure Homebrew is installed
if source zsh-setup-scripts/homebrew/is_installed.sh; then
  log_success "Homebrew is installed"
else
  log_failure "Homebrew installation failed. Please check the logs above."
  return 1
fi

# Ensure dotbot is installed
if ! command -v dotbot &>/dev/null; then
  log_warn "Dotbot not installed. Installing now..."
  if brew install dotbot 2>&1 | output_stream; then
    log_success "Dotbot installed successfully!"
  else
    log_failure "Dotbot installation failed!"
    return 1
  fi
else
  log_success "Dotbot already installed"

  # Upgrade Dotbot submodule
  log_user "Updating Dotbot..."
  output=$(brew upgrade dotbot 2>&1)
  exit_code=$?  # Capture exit status

  # Filter output but maintain original exit code
  echo "$output" | grep -v "already installed" | output_stream 2>/dev/null

  if [ $exit_code -eq 0 ]; then
    log_success "Dotbot update successful"
  else
    log_fatal "Dotbot update failed"
    return 1
  fi
fi

# Ensure XDG_CONFIG_HOME is set (default to ~/.config if not defined)
typeset -gx XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
# Ensure XDG_DATA_HOME is set (default to ~/.data if not defined)
typeset -gx XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.data}"
# Ensure XDG_CACHE_HOME is set (default to ~/.cache if not defined)
typeset -gx XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

CONFIG="dotbot.conf.yaml"

if [[ ! -s "$CONFIG" ]]; then
  log_fatal "Dotbot config file '$CONFIG' is missing or empty!" >&2
  return 1
fi

# Check if file contains env vars like $XDG_CONFIG_HOME
if [[ -s "$CONFIG" ]]; then
  if grep -q '\$' "$CONFIG"; then
    # Ensure envsubst binary is installed
    if ! command -v envsubst &>/dev/null; then
      log_warn "envsubst binary not installed. Installing gettext now..."
      if brew install gettext 2>&1 | output_stream; then
        log_success "gettext installed successfully!"
      else
        log_fatal "gettext installation failed!"
        return 1
      fi
    fi
    
    # Try to use system envsubst; if unavailable, fallback to ./bin/envsubst if present
    if command -v envsubst &>/dev/null; then
      # Create a temporary file to hold the substituted config
      TMPFILE="$(mktemp)"
      
      # Perform environment variable substitution
      envsubst < "$CONFIG" > "$TMPFILE"

      # Run DotBot with environment variable substitution
      log_user "Starting Dotbot with envsubst..."
      [[ is_debug_enabled ]] && _disable_debug && should_reenable_debug=true
      output=$(dotbot --force-color -c "$CONFIG" "$@" 2>&1)
      exit_code=$?  # Capture exit status
      [[ "$should_reenable_debug" == true ]] && _enable_debug

      # Capture output but maintain original exit code
      echo "$output" | output_stream 2>/dev/null

      # Clean up temporary file
      rm -f "$TMPFILE"
      
    else
      log_fatal "envsubst not found. Please install gettext."
      return 1
    fi

  else
    log_user "Starting Dotbot..."
    [[ is_debug_enabled ]] && _disable_debug && should_reenable_debug=true
    output=$(dotbot --force-color -c "$CONFIG" "$@" 2>&1)
    exit_code=$?  # Capture exit status
    [[ "$should_reenable_debug" == true ]] && _enable_debug

    # Capture output but maintain original exit code
    echo "$output" | output_stream 2>/dev/null
  fi
else
  log_fatal "Config file $CONFIG is missing or empty!"
  return 1
fi
