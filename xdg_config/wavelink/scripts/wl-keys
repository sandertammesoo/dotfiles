#!/bin/sh
#
# Bind the media keys to Wave Link only while Wave Link is running.
#
# A macOS volume change on a Bluetooth output makes Wave Link go silent or
# distort, so while Wave Link runs the keys must drive the Wave Link mix
# instead. While Wave Link is not running there is nothing to protect, and a
# bound key costs a process spawn and loses the native volume HUD and the
# feedback click. So the bindings are written to a generated file that skhd
# loads, and this script keeps that file in step with the process.
#
#   wl-keys sync     write the correct state and reload skhd if it changed
#   wl-keys status   print "on" or "off"
#
# skhd resolves a relative .load path against its own config directory, and it
# does not expand a tilde, so the generated file must live beside skhdrc.

SKHD_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/skhd"
GENERATED="$SKHD_DIR/wavelink-keys.generated"
WL_VOL="$HOME/.local/bin/wl-vol"
SKETCHYBAR=/opt/homebrew/bin/sketchybar

wave_link_running() {
  pgrep -qx WaveLinkMacOS
}

bindings_on() {
  cat <<EOF
# Generated by wl-keys. Do not edit. Wave Link is running, so the media keys
# drive the Wave Link mix and never reach the Bluetooth device.
default, normal, moonlander < sound_up   : $WL_VOL up   && $SKETCHYBAR --trigger wl_volume_change
default, normal, moonlander < sound_down : $WL_VOL down && $SKETCHYBAR --trigger wl_volume_change
default, normal, moonlander < mute       : $WL_VOL mute && $SKETCHYBAR --trigger wl_volume_change
EOF
}

bindings_off() {
  cat <<'EOF'
# Generated by wl-keys. Do not edit. Wave Link is not running, so no binding is
# declared and macOS handles the media keys natively.
EOF
}

case "${1:-sync}" in
  status)
    if grep -q '^default' "$GENERATED" 2>/dev/null; then echo on; else echo off; fi
    ;;
  sync)
    if wave_link_running; then
      WANTED=$(bindings_on)
    else
      WANTED=$(bindings_off)
    fi

    # Reload skhd only when the content really changes. A reload on every poll
    # would rebuild every hotkey ten times a minute.
    if [ "$WANTED" != "$(cat "$GENERATED" 2>/dev/null)" ]; then
      mkdir -p "$SKHD_DIR"
      printf '%s\n' "$WANTED" > "$GENERATED"
      skhd --reload
    fi
    ;;
  *)
    sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
