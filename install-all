#!/usr/bin/env zsh

# Parse options using zparseopts
local -A opts

# zparseopts syntax reference: https://zsh.sourceforge.io/Doc/Release/Parameters.html#index-zparseopts
# zparseopts flags:
  # -D : Remove recognized options from positional parameters
  # -A : Store options in associative array
  # -E : Stop option parsing at first non-option argument
  # -F : Fail if unknown options are encountered 
zparseopts -D -E -F -A opts -- \
  h -help \
  d -skip-dotbot \
  u -skip-updates \
  o -skip-osx-updates \
  i -skip-app-installation \
  b -skip-brew-upgrades \
  s -skip-services \
  l -setup-lazyman \
  T -trace \
  V -verbose \
  D -debug \
  Q -quiet \
  S -silent || {
    echo "Error parsing options"
    echo "Usage: ./install-all [options] [--help]"
    return 1
  }

# Check for help flag
if (( ${+opts[-h]} )) || (( ${+opts[--help]} )); then
    echo "Usage: ./install-all [options]"
    echo ""
    echo "Options:"
    echo "  -h, --help                    Show this help message"
    echo "  -d, --skip-dotbot             Skip DotBot installation"
    echo "  -u, --skip-updates            Skip updates (OSX, Homebrew updates and installs)"
    echo "  -o, --skip-osx-updates        Skip macOS updates"
    echo "  -i, --skip-app-installation   Skip application installation (Homebrew/mas)"
    echo "  -b, --skip-brew-upgrades      Skip Homebrew updates"
    echo "  -s, --skip-services           Skip Homebrew services setup"
    echo "  -l, --setup-lazyman           Setup Lazyman setup"
    echo "  -T, --trace                   Show trace output"
    echo "  -V, --verbose                 Show verbose output"
    echo "  -D, --debug                   Show debug output"
    echo "  -Q, --quiet                   Suppress output except for errors"
    echo "  -S, --silent                  Suppress all output"
    return 0
fi

# Save current logging environment variable values to restore later
local SAVED_LOG_LEVEL="${LOG_LEVEL:-INFO}"
local SAVED_LOG_ENABLED="${LOG_ENABLED:-false}"

# Set logging level based on options
if (( ${+opts[-T]} )) || (( ${+opts[--trace]} )); then
    typeset -gx LOG_LEVEL="TRACE"
    typeset -gx LOG_ENABLED=true
elif (( ${+opts[-V]} )) || (( ${+opts[--verbose]} )); then
    typeset -gx LOG_LEVEL="VERBOSE"
    typeset -gx LOG_ENABLED=true
elif (( ${+opts[-D]} )) || (( ${+opts[--debug]} )); then
    typeset -gx LOG_LEVEL="DEBUG"
    typeset -gx LOG_ENABLED=true
elif (( ${+opts[-Q]} )) || (( ${+opts[--quiet]} )); then
    typeset -gx LOG_LEVEL="ERROR"
    typeset -gx LOG_ENABLED=false
elif (( ${+opts[-S]} )) || (( ${+opts[--silent]} )); then
    typeset -gx LOG_LEVEL="FATAL"
    typeset -gx LOG_ENABLED=false
else
    typeset -gx LOG_LEVEL="INFO"
    typeset -gx LOG_ENABLED=true
fi

# Set global flags to skip certain steps
typeset -gx SKIP_DOTBOT=false
(( ${+opts[-d]} || ${+opts[--skip-dotbot]} )) && SKIP_DOTBOT=true

typeset -gx SKIP_UPDATES=false
(( ${+opts[-u]} || ${+opts[--skip-updates]} )) && SKIP_UPDATES=true

typeset -gx SKIP_OSX_UPDATES=false
(( ${+opts[-o]} || ${+opts[--skip-osx-updates]} )) && SKIP_OSX_UPDATES=true

typeset -gx SKIP_APP_INSTALLATION=false
(( ${+opts[-i]} || ${+opts[--skip-app-installation]} )) && SKIP_APP_INSTALLATION=true

typeset -gx SKIP_BREW_UPGRADES=false
(( ${+opts[-b]} || ${+opts[--skip-brew-upgrades]} )) && SKIP_BREW_UPGRADES=true

typeset -gx SKIP_SERVICES=false
(( ${+opts[-s]} || ${+opts[--skip-services]} )) && SKIP_SERVICES=true

typeset -gx SETUP_LAZYMAN=false
(( ${+opts[-l]} || ${+opts[--setup-lazyman]} )) && SETUP_LAZYMAN=true

# Track exit code - start with success, set to 1 on any failure
local exit_code=0

# Cleanup function on exit to unset global flags if they are set
cleanup() {
  log_trace "Restoring logging environment variables..."
  typeset -gx LOG_LEVEL="$SAVED_LOG_LEVEL"
  typeset -gx LOG_ENABLED="$SAVED_LOG_ENABLED"

  if [[ -n "$SUDO_KEEPALIVE_PID" ]]; then
    log_trace "Killing sudo keep-alive process..."
    if kill "$SUDO_KEEPALIVE_PID" &>/dev/null; then
      log_trace "Successfully killed sudo keep-alive process"
    fi
    unset SUDO_KEEPALIVE_PID
  fi

  [[ -n "${SKIP_DOTBOT+x}" ]] && unset SKIP_DOTBOT
  [[ -n "${SKIP_UPDATES+x}" ]] && unset SKIP_UPDATES
  [[ -n "${SKIP_OSX_UPDATES+x}" ]] && unset SKIP_OSX_UPDATES
  [[ -n "${SKIP_APP_INSTALLATION+x}" ]] && unset SKIP_APP_INSTALLATION
  [[ -n "${SKIP_BREW_UPGRADES+x}" ]] && unset SKIP_BREW_UPGRADES
  [[ -n "${SKIP_SERVICES+x}" ]] && unset SKIP_SERVICES
  [[ -n "${SETUP_LAZYMAN+x}" ]] && unset SETUP_LAZYMAN
}
trap cleanup EXIT

# Load helper functions for logging
source helpers.zsh

BASEDIR="${0:A:h}"
log_verbose "Detected BASEDIR=$BASEDIR"

# Request sudo privileges once
log_user "Requesting sudo privileges..."
if sudo -v 2>/dev/null; then
  log_success "Sudo access granted"
  log_trace "Keeping sudo alive..."
  # Keep sudo token alive in background with timeout and parent check
  # Max 60 iterations = 30 minutes, stops if parent process exits
  (for i in {1..60}; do
    sudo -n true 2>/dev/null || break
    kill -0 $$ 2>/dev/null || break  # Check if parent still exists
    sleep 30
  done) &
  SUDO_KEEPALIVE_PID="$!"
else
  log_fatal "Sudo access denied"
  exit 1
fi

#info "Checking local git setup..."
#if setup_gitconfig 2>&1
#then
#  log_success "Git config setup done"
#else
#  log_failure "Error setting up git config"
#fi

# Check if DotBot installation should be skipped
if [[ "$SKIP_DOTBOT" == "true" ]]; then
  log_skip "Skipping DotBot installation."
else
  # Run DotBot install script
  log_user "Running DotBot installation..."
  if source ./run-dotbot; then
    log_success "Dotbot completed successfully!"
  else
    log_fatal "Dotbot failed!"
    exit 1
  fi
fi

# macOS-specific setup
if [[ "$(uname -s)" == "Darwin" ]]; then
  log_trace "Detected macOS, proceeding with additional setup..."
  local DOTS="$XDG_CONFIG_HOME/.dotfiles"

#   # TODO: Go over the defaults config
#   #log_info "Setting OS X defaults..."
#   #if $DOTS/zsh-setup-scripts/osx/set-defaults.sh 2>&1
#   #then
#   #  log_success "OS X defaults set"
#   #  log_info "NOTE that some of these changes require a logout/restart to take effect."
#   #else
#   #  log_failure "Error setting OS X defaults"
#   #fi

  log_user "Install dependencies next..."
  log_user "Searching for installers..."

  # Whitelist of allowed installer directories for security
  local allowed_installer_paths=(
    "zsh-setup-scripts/homebrew/install.sh"
    "zsh-setup-scripts/osx/install.sh"
    "zsh-setup-scripts/gitleaks/install.sh"
    # "zsh-setup-scripts/lazyman/install.sh"
  )

  # Build list of installers using null-terminated find for safety with spaces
  local -a installers
  while IFS= read -r -d '' installer; do
    # Validate installer is in whitelist
    local is_allowed=false
    for allowed_path in "${allowed_installer_paths[@]}"; do
      if [[ "$installer" == "./$allowed_path" || "$installer" == "$allowed_path" ]]; then
        is_allowed=true
        break
      fi
    done

    if [[ "$is_allowed" == "true" ]]; then
      installers+=("$installer")
    else
      log_skip "Skipping non-whitelisted installer: $installer"
    fi
  done < <(find . -name install.sh -print0)

  if [[ ${#installers[@]} -eq 0 ]]; then
    log_warn "No whitelisted installers found."
  else
    log_debug "Found ${#installers[@]} whitelisted installers. Executing..."
    failed_installers=()
    for installer in "${installers[@]}"; do
      log_debug "Running ${installer}..."
      if source "${installer}"; then
        log_success "${installer} completed successfully."
      else
        log_warn "${installer} failed, but continuing with remaining installers."
        failed_installers+=("${installer}")
      fi
    done

    if [[ ${#failed_installers[@]} -gt 0 ]]; then
      log_warn "The following installers failed:"
      for failed in "${failed_installers[@]}"; do
        log_warn "  - ${failed}"
      done
      exit_code=1
    fi
  fi
else
  log_info "Non-macOS system detected, skipping macOS setup."
fi

# Completion message
log_success "Installation complete!"


# Check if services setup should be skipped
if [[ "$SKIP_SERVICES" == "true" ]]; then
  log_skip "Skipping Homebrew services setup."
else
  log_user "Running yabai bootstrap..."
  if zsh zsh-setup-scripts/yabai/bootstrap.sh; then
    log_success "Yabai setup completed successfully!"
  else
    log_failure "Yabai setup failed!"
    exit_code=1
  fi

  log_user "Running skhd bootstrap..."
  if zsh zsh-setup-scripts/skhd/bootstrap.sh; then
    log_success "skhd setup completed successfully!"
  else
    log_failure "skhd setup failed!"
    exit_code=1
  fi

  log_user "Running sketchybar bootstrap..."
  if zsh zsh-setup-scripts/sketchybar/bootstrap.sh; then
    log_success "sketchybar setup completed successfully!"
  else
    log_failure "sketchybar setup failed!"
    exit_code=1
  fi

  log_user "Running borders bootstrap..."
  if zsh zsh-setup-scripts/borders/bootstrap.sh; then
    log_success "borders setup completed successfully!"
  else
    log_failure "borders setup failed!"
    exit_code=1
  fi
fi

# Final completion message
if [[ $exit_code -eq 0 ]]; then
  log_success "All installation and configuration complete!"
  log_info "Your dotfiles have been successfully installed and configured."
else
  log_warn "Installation completed with some failures. Please review the logs above."
fi

# Exit with appropriate code
exit $exit_code


