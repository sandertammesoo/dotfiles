cask_args appdir: "/Applications"

# ============================================================================
# Binary Analysis & Reverse Engineering
# ============================================================================

brew "binutils"     # GNU binary tools for native development - https://www.gnu.org/software/binutils/binutils.html
brew "binwalk"      # Searches a binary image for embedded files and executable code - https://github.com/ReFirmLabs/binwalk
brew "dex2jar"      # Tools to work with Android .dex and Java .class files - https://github.com/pxb1988/dex2jar

# Additional Tools (commented - uncomment as needed)
