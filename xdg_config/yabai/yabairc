#!/usr/bin/env sh

# for this to work you must configure sudo such that
# it will be able to run the command without password
#
# see this wiki page for information:
#  - https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)#configure-scripting-addition
#
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# S K E T C H Y B A R  E V E N T S
yabai -m signal --add event="window_focused" action="sketchybar -m --trigger window_focus &> /dev/null"
yabai -m signal --add event="window_title_changed" action="sketchybar -m --trigger title_change &> /dev/null"
# yabai -m signal --add label="flash_focus" event="window_focused" action="yabai -m window \$YABAI_WINDOW_ID --opacity 0.3 && sleep 0.2 && yabai -m window \$YABAI_WINDOW_ID --opacity 0.0"

# D E B U G  L O G G I N G  F O R  M I N I M I Z E  B U G
yabai -m signal --add event=window_minimized action='date "+[%Y-%m-%d %H:%M:%S:%N] MINIMIZED: $YABAI_WINDOW_ID ($YABAI_WINDOW_APP)" >> /tmp/yabai_minimize_debug.log'
yabai -m signal --add event=window_deminimized action='date "+[%Y-%m-%d %H:%M:%S:%N] DEMINIMIZED: $YABAI_WINDOW_ID ($YABAI_WINDOW_APP)" >> /tmp/yabai_minimize_debug.log'
yabai -m signal --add event=window_focused action='echo "[$(date "+%Y-%m-%d %H:%M:%S:%N")] FOCUSED: $YABAI_WINDOW_ID ($YABAI_WINDOW_APP) - is-minimized=$(yabai -m query --windows --window $YABAI_WINDOW_ID 2>/dev/null | jq -r '."is-minimized"')" >> /tmp/yabai_minimize_debug.log'
yabai -m signal --add event=application_front_switched action='echo "[$(date "+%Y-%m-%d %H:%M:%S:%N")] APP SWITCHED: $YABAI_PROCESS_ID - $(ps -p $YABAI_PROCESS_ID -o comm= 2>/dev/null)" >> /tmp/yabai_minimize_debug.log'

# Optional signals - disabled by default
