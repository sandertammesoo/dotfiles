[submodule "vim/bundle/vim-pathogen"]
	path = xdg_config/vim/bundle/vim-pathogen
	url = https://github.com/tpope/vim-pathogen.git
	ignore = untracked
[submodule "vim/bundle/vim-colors-solarized"]
	path = xdg_config/vim/bundle/vim-colors-solarized
	url = https://github.com/altercation/vim-colors-solarized.git
[submodule "vim/bundle/vim-neatstatus"]
	path = xdg_config/vim/bundle/vim-neatstatus
	url = https://github.com/maciakl/vim-neatstatus.git
[submodule "uncrustify-config"]
	path = git-submodules/uncrustify-config
	url = https://sandertammesoo@bitbucket.org/snippets/sandertammesoo/p6eBq/uncrustify-config.git
[submodule "git-submodules/dotbot"]
	path = git-submodules/dotbot
	url = https://github.com/anishathalye/dotbot
	ignore = dirty
[submodule "git-submodules/AstroNvim"]
	path = git-submodules/AstroNvim
	url = https://github.com/sandertammesoo/AstroNvim.git
[submodule "git-submodules/nvim-lazyman"]
	path = git-submodules/nvim-lazyman
	url = https://github.com/doctorfree/nvim-lazyman
[submodule "xdg_config/cheat/cheatsheets/community"]
	path = xdg_config/cheat/cheatsheets/community
	url = https://github.com/cheat/cheatsheets.git
[submodule "git-submodules/zunit"]
	path = git-submodules/zunit
	url = https://github.com/zunit-zsh/zunit.git
