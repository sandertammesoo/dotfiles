#!/usr/bin/env zsh

# try-rs shell integration, done by hand instead of `try-rs --setup zsh`.
#
# Why not the built-in setup: it appends `source ...` to a hardcoded
# ~/.zshrc (ignores ZDOTDIR). Why the file below must still exist: every TUI
# launch checks only for $XDG_CONFIG_HOME/try-rs/try-rs.zsh and, if missing,
# prompts to run that setup (Enter = yes).
#
# So this module writes `try-rs --setup-stdout zsh` to that path itself and
# sources it. The first line records the resolved binary path, which holds the
# Cellar version, so a brew upgrade regenerates the file without spawning
# try-rs on every shell start.
#
# Why completion.zsh and not env.zsh: the generated script defines the
# try-rs wrapper function and ends with `compdef _try_rs_complete try-rs`,
# which needs compinit — and compinit runs between env and completion files.
if (( $+commands[try-rs] )); then
    _try_rs_script="${TRY_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/try-rs}/try-rs.zsh"
    _try_rs_stamp="# generated by dotfiles from ${commands[try-rs]:A}"

    if [[ "$(head -n 1 "$_try_rs_script" 2>/dev/null)" != "$_try_rs_stamp" ]]; then
        mkdir -p "${_try_rs_script:h}"
        # Upstream bug (1.7.11): the completion helper expands `~` in a
        # comma-separated tries_path with `sed "s|~|$HOME|"`, so only the
        # first path resolves and the other tabs get no completion. Add `g`.
        # If upstream rewrites that line, this replacement is a no-op.
        _try_rs_from='sed "s|~|$HOME|"' _try_rs_to='sed "s|~|$HOME|g"'
        if _try_rs_content="$(command try-rs --setup-stdout zsh)" \
            && print -rl -- "$_try_rs_stamp" "${_try_rs_content//"$_try_rs_from"/$_try_rs_to}" \
                > "${_try_rs_script}.tmp" \
            && mv -f "${_try_rs_script}.tmp" "$_try_rs_script"; then
            log_success "try-rs shell integration generated at $_try_rs_script"
        else
            rm -f "${_try_rs_script}.tmp"
            log_error "Failed to generate try-rs shell integration"
        fi
    fi

    if [[ -f "$_try_rs_script" ]] && source "$_try_rs_script"; then
        log_success "try-rs shell integration and completion loaded"
    else
        log_error "Failed to load try-rs shell integration from $_try_rs_script"
    fi

    unset _try_rs_script _try_rs_stamp _try_rs_content _try_rs_from _try_rs_to
else
    log_skip "try-rs not found, skipping try-rs shell integration"
fi
