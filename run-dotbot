#!/usr/bin/env zsh
source helpers.zsh
src "$(basename "${(%):-%x}")"

# Ensure Homebrew is installed
if ! command -v brew &>/dev/null; then
  if ! command -v /opt/homebrew/bin/brew &>/dev/null; then
    warn " ! Homebrew not installed. Installing now..."
    
    # Install Homebrew based on OS
    case "$(uname -s)" in
      Darwin|Linux)  
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" && \
          success "  ✓ Homebrew install successful" || {
          fail " ✗ Installation failed: Homebrew installation script returned an error."
          exit 1
        }
        ;;
      *)  
        fail " ✗ Installation failed: Unsupported OS ($(uname -s))"
        exit 1
        ;;
    esac
  fi
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

# Ensure Homebrew is installed
if ! command -v dotbot &>/dev/null; then
  warn " ! Dotbot not installed. Installing now..."
  if brew install dotbot 2>&1 | info_stream; then
    success "  ✓ Dotbot installed successfully!"
  else
    fail "  ✗ Dotbot installation failed!"
  fi
else
  success "  ✓ Dotbot already installed"

  # Upgrade Dotbot submodule
  user "Updating Dotbot..."
  output=$(brew upgrade dotbot 2>&1)
  exit_code=$?  # Capture exit status

  # Filter output but maintain original exit code
  echo "$output" | grep -v "already installed" | info_stream 2>/dev/null

  if [ $exit_code -eq 0 ]; then
    success "  ✓ Dotbot update successful"
  else
    fail "  ✗ Dotbot update failed"
  fi
fi

# Ensure XDG_CONFIG_HOME is set (default to ~/.config if not defined)
typeset -gx XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

CONFIG="dotbot.conf.yaml"

if [[ ! -s "$CONFIG" ]]; then
  echo "✗ Dotbot config file '$CONFIG' is missing or empty!" >&2
  exit 1
fi

# Check if file contains env vars like $XDG_CONFIG_HOME
if [[ -s "$CONFIG" ]]; then
  if grep -q '\$' "$CONFIG"; then
# Run DotBot with environment variable substitution
    user "▶ Starting Dotbot with envsubst..."
    TMPFILE="$(mktemp)"
    envsubst < "$CONFIG" > "$TMPFILE"
    dotbot -c "$CONFIG" "$@" | info_stream
    rm -f "$TMPFILE"
    # envsubst < "$CONFIG" | dotbot -c - "$@"
  else
    user "▶ Starting Dotbot..."
    dotbot -c "$CONFIG" "$@" | info_stream
  fi
else
  fail "Config file $CONFIG is missing or empty!"
  exit 1
fi
